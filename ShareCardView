// MARK: - 1080×1350 card (fixed pixel layout; scaled down only for on-screen preview)
struct ShareCardView: View {
    let subject: String
    let durationSeconds: Int
    let streak: Int
    let date: Date
    let thumbnail: UIImage?

    static let size = CGSize(width: 1080, height: 1350)

    private var durationText: String {
        "\(durationSeconds / 3600)h \((durationSeconds % 3600) / 60)m"
    }

    var body: some View {
        ZStack {
            LinearGradient(colors: [Color(red: 0.06, green: 0.08, blue: 0.16),
                                    Color(red: 0.14, green: 0.10, blue: 0.30)],
                           startPoint: .topLeading, endPoint: .bottomTrailing)

            VStack(spacing: 0) {
                // Header
                Text("LATENT iPAD")
                    .font(.system(size: 48, weight: .heavy, design: .rounded))
                    .tracking(10)
                    .foregroundStyle(.white.opacity(0.9))
                    .padding(.top, 80)

                // Timelapse thumbnail
                ZStack {
                    if let thumbnail {
                        Image(uiImage: thumbnail)
                            .resizable()
                            .scaledToFill()
                    } else {
                        ZStack {
                            Color.white.opacity(0.08)
                            Image(systemName: "film")
                                .font(.system(size: 120))
                                .foregroundStyle(.white.opacity(0.3))
                        }
                    }
                }
                .frame(width: 920, height: 560)
                .clipShape(RoundedRectangle(cornerRadius: 48, style: .continuous))
                .overlay(
                    RoundedRectangle(cornerRadius: 48, style: .continuous)
                        .strokeBorder(.white.opacity(0.2), lineWidth: 3)
                )
                .padding(.top, 60)

                // Subject badge
                Text(subject.uppercased())
                    .font(.system(size: 44, weight: .bold, design: .rounded))
                    .foregroundStyle(.white)
                    .padding(.horizontal, 44)
                    .padding(.vertical, 18)
                    .background(Capsule().fill(Color.accentColor))
                    .padding(.top, 56)

                // Duration
                Text(durationText)
                    .font(.system(size: 190, weight: .bold, design: .rounded))
                    .monospacedDigit()
                    .minimumScaleFactor(0.5)
                    .lineLimit(1)
                    .foregroundStyle(.white)
                    .padding(.top, 10)

                Spacer(minLength: 0)

                // Streak + date
                HStack(spacing: 28) {
                    HStack(spacing: 14) {
                        Image(systemName: "flame.fill")
                            .font(.system(size: 46))
                            .foregroundStyle(.orange)
                        Text("\(streak) day\(streak == 1 ? "" : "s")")
                            .font(.system(size: 42, weight: .semibold, design: .rounded))
                    }
                    .padding(.horizontal, 36)
                    .padding(.vertical, 18)
                    .background(Capsule().fill(.white.opacity(0.12)))

                    Text(date.formatted(date: .abbreviated, time: .omitted))
                        .font(.system(size: 42, weight: .medium, design: .rounded))
                        .foregroundStyle(.white.opacity(0.7))
                }
                .foregroundStyle(.white)
                .padding(.bottom, 80)
            }
            .frame(width: Self.size.width, height: Self.size.height)
        }
        .frame(width: Self.size.width, height: Self.size.height)
        .environment(\.colorScheme, .dark) // ImageRenderer doesn't inherit environment
    }
}

// MARK: - Share sheet
struct ShareSummarySheet: View {
    let session: StudySession
    let streak: Int

    @Environment(\.dismiss) private var dismiss
    @State private var thumbnail: UIImage?
    @State private var rendered: UIImage?

    private var card: ShareCardView {
        ShareCardView(subject: session.subject,
                      durationSeconds: session.durationSeconds,
                      streak: streak,
                      date: session.date,
                      thumbnail: thumbnail)
    }

    var body: some View {
        NavigationStack {
            GeometryReader { geo in
                // Scale the fixed 1080×1350 card to fit the available space
                let s = min(geo.size.width / ShareCardView.size.width,
                            geo.size.height / ShareCardView.size.height)
                card
                    .scaleEffect(s)
                    .frame(width: ShareCardView.size.width * s,
                           height: ShareCardView.size.height * s)
                    .clipShape(RoundedRectangle(cornerRadius: 24, style: .continuous))
                    .shadow(radius: 12)
                    .frame(maxWidth: .infinity, maxHeight: .infinity)
            }
            .padding(24)
            .navigationTitle("Share Session")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .topBarLeading) { Button("Done") { dismiss() } }
                ToolbarItem(placement: .topBarTrailing) {
                    if let rendered {
                        ShareLink(item: Image(uiImage: rendered),
                                  preview: SharePreview("\(session.subject) study session",
                                                        image: Image(uiImage: rendered))) {
                            Label("Share", systemImage: "square.and.arrow.up")
                        }
                    } else {
                        ProgressView()
                    }
                }
            }
        }
        .task {
            if let id = session.timelapseAssetID {
                thumbnail = await Self.grabThumbnail(assetID: id)
            }
            render()
        }
    }

    // Render the card to a 1080×1350 px UIImage
    private func render() {
        let renderer = ImageRenderer(content: card)
        renderer.scale = 1 // 1 pt = 1 px → exactly 1080×1350
        rendered = renderer.uiImage
    }

    // Grab a frame from the middle of the saved timelapse
    private static func grabThumbnail(assetID: String) async -> UIImage? {
        let status = await PHPhotoLibrary.requestAuthorization(for: .readWrite)
        guard status == .authorized || status == .limited,
              let asset = PHAsset.fetchAssets(withLocalIdentifiers: [assetID], options: nil).firstObject
        else { return nil }

        let avAsset: AVAsset? = await withCheckedContinuation { cont in
            let opts = PHVideoRequestOptions()
            opts.isNetworkAccessAllowed = true
            opts.deliveryMode = .highQualityFormat
            PHImageManager.default().requestAVAsset(forVideo: asset, options: opts) { a, _, _ in
                cont.resume(returning: a)
            }
        }
        guard let avAsset else { return nil }

        let generator = AVAssetImageGenerator(asset: avAsset)
        generator.appliesPreferredTrackTransform = true // keep frame upright
        generator.maximumSize = CGSize(width: 1840, height: 1840)
        generator.requestedTimeToleranceBefore = .positiveInfinity
        generator.requestedTimeToleranceAfter = .positiveInfinity

        guard let duration = try? await avAsset.load(.duration) else { return nil }
        let mid = CMTimeMultiplyByFloat64(duration, multiplier: 0.5)
        guard let cg = try? await generator.image(at: mid).image else { return nil }
        return UIImage(cgImage: cg)
    }
}
